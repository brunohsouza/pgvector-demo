# Copy to .env and fill in what you use. Shell variables win over these, so
# `npm run start:gemini` still overrides EMBEDDINGS_PROVIDER.

# Host port 5433 keeps the demo clear of any other local Postgres on 5432.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres

# openai (default) | gemini | voyage | fake
EMBEDDINGS_PROVIDER=openai

# Set the key for the provider you chose.
OPENAI_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=
# Voyage keys created in MongoDB Atlas use a different address:
# VOYAGE_BASE_URL=https://ai.mongodb.com/v1

# PORT=3000
# The API binds to 127.0.0.1. Set HOST=0.0.0.0 only if another machine must reach it.
# HOST=127.0.0.1
